"changelog": {
  "version": "6.0.6",
  "title": "What's New in 6.0.6",
  "items": [
    "Fixed updater comparing against a hardcoded version",
    "Fixed changelog popup appearing on every launch",
    "Fixed non-Steam games failing to launch from the modal, context menu and quick launcher",
    "Fixed achievement cache expiring instantly (far fewer Steam API calls)",
    "Update notifications now actually appear, with a clickable download toast",
    "Playtime is now saved when quitting mid-session",
    "Ghost process cleanup when a game never starts",
    "Beta update channel selectable in Settings",
    "Library scan uses the registry Steam path + all library folders",
    "Game tracking falls back from wmic to PowerShell on Windows 11 24H2+",
    "Screenshots stream from disk instead of base64 (much lighter)",
    "Dashboard renders instantly, news loads async",
    "Friends polling halved to every 30s",
    "Discord Rich Presence shows the game's cover art while playing",
    "Clear button for custom executable paths in Properties"
  ]
}
